# Every setting here is OPTIONAL. With Docker, VeriFace generates its own secret
# key and push-notification keys on first run and keeps them in the data volume.

# --- Access ---------------------------------------------------------------
# Port exposed on this machine
VERIFACE_PORT=8000
# Only needed for a custom domain, e.g. https://door.example.com
# (*.trycloudflare.com, *.ts.net and *.ngrok-free.app are already allowed)
CSRF_TRUSTED_ORIGINS=
# Set to true once you serve over HTTPS only (tunnel / reverse proxy)
SECURE_COOKIES=false

# --- Skip the web setup wizard (headless installs) ---------------------------
# CAMERA_SOURCE=rtsp://user:pass@192.168.1.20:554/stream1
# DEVICE_NAME=Front Door
# DEVICE_ID=DOOR-001

# --- Recognition ----------------------------------------------------------
# Cosine similarity needed to open the door (0-1). Higher = stricter.
FACE_SIMILARITY_THRESHOLD=0.4
MAX_FAMILY_MEMBERS=5

# --- Door hardware (Linux hosts) ------------------------------------------
# 'auto' finds an Arduino on /dev/ttyACM* or /dev/ttyUSB*
ARDUINO_PORT=auto
ARDUINO_BAUDRATE=9600

# --- Permanent Cloudflare Tunnel (optional) ---------------------------------
# TUNNEL_TOKEN=

# --- Overrides (normally leave unset) ---------------------------------------
# SECRET_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=you@example.com
# DB_ENGINE=postgresql  (+ DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT)
# DEBUG=false
